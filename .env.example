# Server-side keys (never shipped to the browser)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini

# Google Calendar — OAuth "Web application" client.
# Authorized redirect URIs to register in Cloud Console:
#   http://localhost:3000/perfil   http://localhost:3001/perfil
#   https://<your-domain>/perfil
# JavaScript origins: the same hosts without the /perfil path.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=....apps.googleusercontent.com

# With the client secret set, the app uses auth-code flow: tokens exchange
# server-side and refresh via an httpOnly cookie, so the calendar stays
# connected past the 1h implicit-token lifetime. Without it, the app falls
# back to the implicit token flow.
GOOGLE_CLIENT_SECRET=GOCSPX-...
NEXT_PUBLIC_GOOGLE_CODE_FLOW=1

# Optional: Supabase persistence + magic-link sign-in
# Run supabase/schema.sql in the SQL editor first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
